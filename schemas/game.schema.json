{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game.json",
  "type": "object",
  "required": ["slug", "title", "sources", "target_minutes", "players", "core_verb", "chapters"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "description": "Vault-relative path in creative-writing/vault/"}},
    "target_minutes": {"type": "object", "required": ["min", "max"],
      "properties": {"min": {"type": "integer", "minimum": 45}, "max": {"type": "integer", "maximum": 180}}},
    "players": {"type": "object", "required": ["min", "max"],
      "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer"}}},
    "core_verb": {"type": "string"},
    "chapters": {"type": "array", "minItems": 3, "items": {"type": "object",
      "required": ["id", "title", "minutes", "layers"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "minutes": {"type": "integer", "minimum": 1},
        "layers": {"type": "array", "items": {"enum": ["3d", "2d", "1d"]}}
      }}}
  }
}
