{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "star_chart.json (WrymWretch)",
  "description": "Star Chart star fields, constellations, their lore fragments, and the sources of Izladar fragments (DESIGN.md sections 11 and 13).",
  "type": "object",
  "required": ["field", "rules", "pages", "per_constellation_named", "izladar_fragment_sources"],
  "$defs": {
    "star": {"type": "object", "required": ["id", "x", "y", "mag"], "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "x": {"type": "number", "minimum": 0, "maximum": 100},
      "y": {"type": "number", "minimum": 0, "maximum": 100}, "mag": {"type": "integer", "minimum": 1, "maximum": 4},
      "false": {"type": "boolean", "description": "Flickers on the false-star cycle; never part of a solution"}}},
    "line": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "rule": {"type": "object", "required": ["type"], "properties": {
      "type": {"enum": ["chain", "cycle", "degree", "edge", "edges", "no_crossing", "line_count"]},
      "stars": {"type": "array", "items": {"type": "string"}},
      "direction": {"enum": ["up", "down", "left", "right", "up_left", "up_right", "down_left", "down_right"]},
      "star": {"type": "string", "description": "A star id, or brightest"},
      "value": {"type": "integer"}, "a": {"type": "string"}, "b": {"type": "string"},
      "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}}},
    "constellation": {"type": "object", "required": ["id", "name", "realm", "stars", "lines", "fragments"], "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "realm": {"enum": ["west", "north", "south", "east", "below", "above"]},
      "stars": {"type": "array", "items": {"$ref": "#/$defs/star"}},
      "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}},
      "missing_star": {"type": "string"},
      "fragments": {"type": "array", "items": {"type": "object", "required": ["text", "rules"], "properties": {
        "order": {"type": "integer"}, "text": {"type": "string"}, "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}}}}}}
  },
  "properties": {
    "field": {"type": "object", "required": ["width", "height"]},
    "rules": {"type": "object"},
    "pages": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object",
      "required": ["scene", "constellations", "other_stars", "stars_per_constellation", "fragments_per_constellation", "false_stars"],
      "properties": {
        "scene": {"type": "string"},
        "constellations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/constellation"}},
        "other_stars": {"type": "array", "items": {"$ref": "#/$defs/star"}},
        "stars_per_constellation": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
        "fragments_per_constellation": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
        "false_stars": {"type": "integer", "minimum": 0},
        "sigil": {"type": "object", "required": ["lines"], "properties": {"lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}}},
        "full_draw_min_fragments": {"type": "integer"},
        "on_complete": {"type": "object"}, "on_constellation": {"type": "object"}
      }}},
    "per_constellation_named": {"type": "object"},
    "izladar_fragment_sources": {"type": "array", "items": {"type": "object", "required": ["id", "scene", "how"],
      "properties": {"id": {"type": "string"}, "scene": {"type": "string"}, "how": {"type": "string"}}}}
  }
}
