{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chart_questions.json",
  "type": "object",
  "required": ["note", "game", "min_cells", "retries_per_day", "rows", "tiers", "crew_columns", "cards", "questions", "ready_day"],
  "properties": {
    "note": {"type": "string"},
    "game": {"type": "string", "description": "A games_1d id from scenes.json"},
    "min_cells": {"type": "integer", "minimum": 1},
    "retries_per_day": {"type": "integer", "minimum": 0},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+$"},
        "label": {"type": "string"},
        "kind": {"enum": ["formula", "state"]},
        "base": {"type": "number", "description": "formula only: the value at change 0"},
        "per_change": {"type": "number", "description": "formula only: added per point of change"},
        "unit": {"type": "string"},
        "at_change_100": {"type": "number", "description": "formula only: the value DESIGN.md gives at change 100"},
        "from": {"type": "array", "items": {"type": "string"}, "description": "state only: flag or ledger names the row reads"},
        "added_on_day": {"type": "integer", "minimum": 1, "maximum": 7, "description": "state only: the day the row joins the page"}
      }}},
    "tiers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object",
      "required": ["tier", "rows", "merged", "display"],
      "properties": {
        "tier": {"type": "integer", "minimum": 1, "maximum": 4},
        "rows": {"type": "array", "items": {"type": "string"}},
        "merged": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "display": {"type": "string"}
      }}},
    "crew_columns": {"type": "object", "required": ["from_day", "crew", "why"],
      "properties": {
        "from_day": {"type": "integer"},
        "crew": {"type": "array", "items": {"type": "string"}, "description": "Each has a pull.<name> meter in flags.json"},
        "why": {"type": "string"}
      }},
    "cards": {"type": "array", "minItems": 4, "maxItems": 6, "items": {"type": "object",
      "required": ["id", "label"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
    "questions": {"type": "array", "items": {"type": "object",
      "required": ["day", "scene", "question", "tests_entry", "tests_explanation", "card", "ruling", "cells", "proof", "second_sheet", "crew_alternative", "cards_offered", "difficulty"],
      "properties": {
        "day": {"type": "integer", "minimum": 2, "maximum": 6},
        "scene": {"type": "string", "description": "A the_chart scene id"},
        "question": {"type": "string"},
        "tests_entry": {"type": "string", "description": "An entry id in list_incidents.json"},
        "tests_explanation": {"type": "string", "description": "One of that entry's explanations"},
        "card": {"type": "string", "description": "The hypothesis card the correct ruling breaks"},
        "ruling": {"enum": ["Supported", "Broken"]},
        "cells": {"type": "object", "required": ["rule", "rows", "days"],
          "properties": {
            "rule": {"enum": ["same_day_pair", "cross_rows_two_days", "both_rise", "against_second_sheet", "cheeked_vs_swallowed"]},
            "rows": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "days": {"type": "array", "items": {"type": "integer"}, "description": "Fixed columns; empty when the run decides them"}
          }},
        "proof": {"type": "string"},
        "second_sheet": {"type": ["string", "null"]},
        "crew_alternative": {"type": "boolean"},
        "cards_offered": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 6},
        "difficulty": {"type": "string"}
      }}},
    "ready_day": {"type": "object", "required": ["day", "scene", "orderly_writes", "fragment_budget_by_tier", "fragments"],
      "properties": {
        "day": {"type": "integer"},
        "scene": {"type": "string"},
        "orderly_writes": {"type": "string"},
        "fragment_budget_by_tier": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
        "fragments": {"type": ["string", "array"], "description": "A marked placeholder until the author supplies them"}
      }}
  }
}
