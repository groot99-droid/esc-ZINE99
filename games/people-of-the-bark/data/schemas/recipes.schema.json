{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recipes.json",
  "description": "People of the Bark: the Sap Kitchen's pot rules, ingredients, twelve recipes and visits (DESIGN.md 11.2).",
  "type": "object",
  "required": ["pot", "thickness", "stirs", "ruined", "ingredients", "recipes", "unmatched", "every_pot", "caps_per_visit", "hints", "visits"],
  "$defs": {
    "effect": {"type": "object", "required": ["state"],
      "properties": {"state": {"type": "string"}, "add": {"type": "integer"}, "set": {}}}
  },
  "properties": {
    "source": {"type": "string"},
    "pot": {"type": "object", "required": ["sap_cost", "max_ingredients", "stirs_max", "heats", "boils"],
      "properties": {"sap_cost": {"type": "integer"}, "max_ingredients": {"type": "integer"}, "stirs_max": {"type": "integer"},
        "heats": {"type": "array", "items": {"type": "string"}}, "boils": {"type": "array", "items": {"type": "string"}}}},
    "thickness": {"type": "array", "items": {"type": "object", "required": ["heat", "boil", "thickness"],
      "properties": {"heat": {"type": "string"}, "boil": {"type": "string"},
        "thickness": {"enum": ["runny", "syrup", "glue", "hard"]}}}},
    "stirs": {"type": "array", "items": {"type": "object", "required": ["min", "max", "texture"],
      "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer"}, "texture": {"type": "string"}}}},
    "ruined": {"type": "object", "required": ["thickness", "texture", "becomes"],
      "properties": {"thickness": {"type": "string"}, "texture": {"type": "string"}, "becomes": {"type": "string"}, "note": {"type": "string"}}},
    "ingredients": {"type": "array", "items": {"type": "object", "required": ["id", "name", "seasons", "base"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"},
        "seasons": {"type": "array", "items": {"type": "string"}}, "base": {"type": "boolean"}}}},
    "recipes": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object",
      "required": ["number", "id", "name", "category", "thickness", "ingredients", "ordered", "stirs", "effects", "opens", "once", "hint"],
      "properties": {"number": {"type": "integer", "minimum": 1, "maximum": 12},
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "name": {"type": "string"},
        "category": {"enum": ["food", "sealant", "offering"]},
        "thickness": {"enum": ["runny", "syrup", "glue", "hard"]},
        "ingredients": {"type": "array", "maxItems": 3, "items": {"type": "string"},
          "description": "added ingredients; sap is always the base and is not listed"},
        "ordered": {"type": "boolean", "description": "true: the ingredients must go in in the listed order"},
        "stirs": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "opens": {"enum": ["spring", "summer", "autumn", "winter"]},
        "once": {"type": "boolean", "description": "true: its effect is given once in the game"},
        "hint": {"type": "string", "description": "the blank entry's hint word"}}}},
    "unmatched": {"type": "object", "required": ["effects", "line"],
      "properties": {"effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "line": {"type": "string"}}},
    "every_pot": {"type": "object", "required": ["found_counter", "offering_counter"],
      "properties": {"found_counter": {"type": "string"}, "offering_counter": {"type": "string"}}},
    "caps_per_visit": {"type": "object", "required": ["sealant", "offering"],
      "properties": {"sealant": {"type": "integer"}, "offering": {"type": "integer"}}},
    "hints": {"type": "object", "required": ["after_pot_words", "failed_in_a_row", "then"],
      "properties": {"after_pot_words": {"type": "array", "items": {"type": "string"}},
        "failed_in_a_row": {"type": "integer"}, "then": {"type": "string"}}},
    "visits": {"type": "array", "items": {"type": "object",
      "required": ["scene", "sap", "open_recipes", "caps_lifted", "goal", "on_finish"],
      "properties": {"scene": {"type": "string"},
        "sap": {"type": ["integer", "string"], "description": "sap given, or \"all\" for the city's whole stock"},
        "open_recipes": {"type": "array", "items": {"type": "integer"}},
        "caps_lifted": {"type": "boolean"}, "goal": {"type": "string"},
        "on_finish": {"type": "array", "items": {"$ref": "#/$defs/effect"}}}}}
  }
}
