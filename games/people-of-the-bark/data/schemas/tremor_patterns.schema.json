{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tremor_patterns.json",
  "description": "People of the Bark: the Tremor Scroll's patterns, weather, and forecast cells with their answers (DESIGN.md 11.5).",
  "type": "object",
  "required": ["parts", "faces", "strengths", "weathers", "rule_order", "scoring", "hints", "total_forecasts", "scholars_ending_needs", "scrolls"],
  "$defs": {
    "effect": {"type": "object", "required": ["state", "add"],
      "properties": {"state": {"type": "string"}, "add": {"type": "integer"}}},
    "glyph": {"type": ["object", "null"], "required": ["face", "strength"],
      "properties": {"face": {"type": "string", "description": "a face, or \"all\" for the tread"},
        "strength": {"type": "integer", "minimum": 1, "maximum": 3}}}
  },
  "properties": {
    "source": {"type": "string"},
    "parts": {"type": "array", "items": {"type": "string"}},
    "faces": {"type": "array", "items": {"type": "string"}},
    "strengths": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "weathers": {"type": "array", "items": {"type": "string"}},
    "rule_order": {"type": "string"},
    "scoring": {"type": "object", "required": ["correct", "fine", "correct_effects", "fine_effects", "every_forecast"],
      "properties": {"correct": {"type": "string"}, "fine": {"type": "string"},
        "correct_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "fine_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "every_forecast": {"type": "array", "items": {"$ref": "#/$defs/effect"}}}},
    "hints": {"type": "object", "required": ["standing", "underline_at", "overlay_at", "extra_levels"],
      "properties": {"standing": {"type": "string"}, "underline_at": {"type": "integer"},
        "overlay_at": {"type": "integer"}, "extra_levels": {"type": "string"}}},
    "total_forecasts": {"type": "integer"},
    "scholars_ending_needs": {"type": "integer"},
    "scrolls": {"type": "array", "items": {"type": "object",
      "required": ["scene", "season", "summary", "days_shown", "rules", "weather", "forecasts"],
      "properties": {"scene": {"type": "string"}, "season": {"type": "string"}, "summary": {"type": "string"},
        "days_shown": {"type": "integer", "minimum": 1},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "object",
          "required": ["part", "face", "strength"],
          "properties": {"part": {"type": "string"}, "face": {"type": "string"},
            "strength": {"type": "integer", "minimum": 1, "maximum": 3},
            "weather": {"type": "array", "items": {"type": "string"}},
            "every": {"type": "integer", "minimum": 2}, "skip_every": {"type": "integer", "minimum": 2},
            "tread": {"type": "boolean"}}}},
        "weather": {"type": "array", "items": {"type": "string"}, "description": "one per day: shown days, then forecast days"},
        "forecasts": {"type": "array", "items": {"type": "object", "required": ["day", "part", "answer"],
          "properties": {"day": {"type": "integer"}, "part": {"type": "string"},
            "answer": {"$ref": "#/$defs/glyph", "description": "null means no tremor"},
            "sets": {"type": "string", "description": "a bool flag set when this forecast is correct"}}}}}}}
  }
}
