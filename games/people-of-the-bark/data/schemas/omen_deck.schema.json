{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "omen_deck.json",
  "description": "People of the Bark: the Omen deck, event cards, spread rules, heirs and the Reading of the Shadow (DESIGN.md 11.1, 12.5).",
  "type": "object",
  "required": ["suits", "sigils", "cards", "event_cards", "rules", "appearances", "god_or_monster", "heirs", "shadow"],
  "$defs": {
    "effect": {"type": "object", "required": ["state", "add"],
      "properties": {"state": {"type": "string"}, "add": {"type": "integer"}}}
  },
  "properties": {
    "source": {"type": "string"},
    "suits": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object",
      "required": ["id", "name", "belief"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "belief": {"type": "string"}}}},
    "sigils": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object",
      "required": ["id", "institution", "standing", "leads_as"],
      "properties": {"id": {"enum": ["eye", "spear", "quill"]}, "institution": {"type": "string"},
        "standing": {"type": "string", "description": "a meter in flags.json"},
        "leads_as": {"type": "string", "description": "a value of year.leading"}}}},
    "cards": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": "object",
      "required": ["id", "name", "suit", "sigil", "weight"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "name": {"type": "string"},
        "suit": {"type": "string"}, "sigil": {"type": "string"},
        "weight": {"type": "integer", "minimum": 1, "maximum": 3}}}},
    "event_cards": {"type": "array", "items": {"type": "object",
      "required": ["id", "name", "suit", "weight", "seen", "cause", "fit_suit", "fit_effects", "fit_note"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"},
        "suit": {"type": ["string", "null"]}, "weight": {"type": "integer"},
        "seen": {"type": "string"}, "cause": {"type": ["string", "null"], "description": "the Backyard card"},
        "fit_suit": {"type": ["string", "null"]},
        "fit_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "fit_note": {"type": ["string", "null"]}}}},
    "rules": {"type": "object",
      "required": ["slots", "tie_break_slot", "hand", "policy", "clear_effects", "bold_effects", "fit_counter", "ledger"],
      "properties": {
        "slots": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3},
        "tie_break_slot": {"type": "string"},
        "hand": {"type": "object", "required": ["base", "standing", "plus_one_at", "event_suit_guaranteed"],
          "properties": {"base": {"type": "integer"}, "standing": {"type": "string"},
            "plus_one_at": {"type": "array", "items": {"type": "integer"}},
            "event_suit_guaranteed": {"type": "integer"}}},
        "policy": {"type": "object", "required": ["two_of_a_sigil", "three_of_a_sigil", "three_others", "balanced_each"],
          "properties": {"two_of_a_sigil": {"type": "integer"}, "three_of_a_sigil": {"type": "integer"},
            "three_others": {"type": "integer"}, "balanced_each": {"type": "integer"}}},
        "clear_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "bold_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "fit_counter": {"type": "string"},
        "ledger": {"type": "string"}}},
    "appearances": {"type": "array", "items": {"type": "object",
      "required": ["scene", "event", "hand", "guided", "decides", "new_idea"],
      "properties": {"scene": {"type": "string"}, "event": {"type": "string"},
        "hand": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
        "guided": {"type": "boolean"}, "decides": {"type": ["string", "null"]},
        "new_idea": {"type": "string"}}}},
    "god_or_monster": {"type": "object", "required": ["monster_if_policy", "monster", "otherwise"],
      "properties": {"monster_if_policy": {"type": "string"}, "monster": {"type": "string"}, "otherwise": {"type": "string"}}},
    "heirs": {"type": "object", "required": ["hand", "by_policy"],
      "properties": {"hand": {"type": "integer"},
        "by_policy": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object",
          "required": ["policy", "heir", "effects"],
          "properties": {"policy": {"enum": ["eye", "spear", "quill", "balanced"]}, "heir": {"type": "string"},
            "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}}}}}},
    "shadow": {"type": "object", "required": ["deck_size", "deck_rule", "hand_base", "hand_modifiers", "fallback", "readings"],
      "properties": {"deck_size": {"type": "integer"}, "deck_rule": {"type": "string"},
        "hand_base": {"type": "integer"},
        "hand_modifiers": {"type": "array", "items": {"type": "object", "required": ["flag", "add"],
          "properties": {"flag": {"type": "string"}, "add": {"type": "integer"}}}},
        "fallback": {"type": "string"},
        "readings": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object",
          "required": ["placed", "reading", "line", "allowed_if", "scene"],
          "properties": {"placed": {"enum": ["balanced", "eye", "spear", "quill"]}, "reading": {"type": "string"},
            "line": {"type": "string"},
            "allowed_if": {"type": ["boolean", "object"], "description": "a condition in the endings.json grammar"},
            "scene": {"type": "string"}}}}}}
  }
}
