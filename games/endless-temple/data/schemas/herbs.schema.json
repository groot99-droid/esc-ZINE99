{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "herbs.json",
  "description": "The Endless Temple: Tea Blending's herbs, steep dial and the six brews (DESIGN.md section 11).",
  "type": "object",
  "required": ["base", "spoons", "steep_dial", "tea_hold", "steep_per_binding", "failed_pour", "hints", "herbs", "brews"],
  "properties": {
    "source": {"type": "string"},
    "base": {"type": "string", "description": "id of the herb always in the cup"},
    "spoons": {"type": "integer", "minimum": 1},
    "steep_dial": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object",
      "required": ["mark", "depth_factor", "length_add", "binding_add"],
      "properties": {
        "mark": {"type": "integer", "minimum": 1, "maximum": 5},
        "depth_factor": {"type": "number", "minimum": 0},
        "length_add": {"type": "integer"},
        "binding_add": {"type": "integer"}
      }}},
    "depth_rounding": {"type": "string"},
    "tea_hold": {"type": "object", "required": ["base", "per_depth", "max"],
      "properties": {"base": {"type": "integer"}, "per_depth": {"type": "integer"}, "max": {"type": "integer"}}},
    "steep_per_binding": {"type": "integer"},
    "failed_pour": {"type": "object", "required": ["sand_leak"],
      "properties": {"sand_leak": {"type": "integer"}, "plain_paragraphs": {"type": "integer"}}},
    "hints": {"type": "object", "required": ["one_more_herb_after_failed_pours", "full_solution_after_failed_pours"],
      "properties": {"one_more_herb_after_failed_pours": {"type": "integer"}, "full_solution_after_failed_pours": {"type": "integer"}}},
    "herbs": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["id", "name", "depth", "length", "binding", "chapter", "scene", "added"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string"},
        "depth": {"type": "integer"},
        "length": {"type": "integer"},
        "binding": {"type": "integer"},
        "chapter": {"type": "string", "description": "chapter id in game.json"},
        "scene": {"type": "string", "description": "scene id in scenes.json that writes the herbs ledger"},
        "added": {"type": "boolean", "description": "true when the herb is not in the author's text"},
        "note": {"type": "string"}
      }}},
    "brews": {"type": "array", "items": {"type": "object",
      "required": ["scene", "requirement", "jars", "solution"],
      "properties": {
        "scene": {"type": "string", "description": "a scene whose game is tea"},
        "requirement": {"type": "object", "properties": {
          "depth_min": {"type": "integer"}, "length_min": {"type": "integer"}, "binding_max": {"type": "integer"}}},
        "jars": {"type": "array", "items": {"type": "string"}},
        "solution": {"type": ["object", "null"], "required": ["spoons", "mark", "result"], "properties": {
          "spoons": {"type": "array", "items": {"type": "string"}},
          "mark": {"type": "integer", "minimum": 1, "maximum": 5},
          "result": {"type": "object", "required": ["depth", "length", "binding"], "properties": {
            "depth": {"type": "integer"}, "length": {"type": "integer"}, "binding": {"type": "integer"}}}
        }},
        "note": {"type": "string"}
      }}}
  }
}
