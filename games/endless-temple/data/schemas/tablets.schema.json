{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tablets.json",
  "description": "The Endless Temple: the four Rule Tablets, with rules, key-word meanings, ways and solutions (DESIGN.md section 11).",
  "type": "object",
  "required": ["plan_slots", "scrutiny", "hints", "tablets"],
  "properties": {
    "source": {"type": "string"},
    "plan_slots": {"type": "integer", "minimum": 1},
    "scrutiny": {"type": "object", "required": ["flag", "per_failed_test", "watcher_at"], "properties": {
      "flag": {"type": "string"}, "per_failed_test": {"type": "integer"}, "watcher_at": {"type": "integer"},
      "reset_each_appearance": {"type": "boolean"}, "watcher_rule_note": {"type": "string"}}},
    "hints": {"type": "object", "required": ["key_word_after_failed_tests", "way_after_failed_tests"], "properties": {
      "key_word_after_failed_tests": {"type": "integer"}, "way_after_failed_tests": {"type": "integer"}}},
    "tablets": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["scene", "book", "title", "want", "loophole_flag", "also_sets", "watcher", "watcher_rule", "rules", "ways", "solution"],
      "properties": {
        "scene": {"type": "string", "description": "a scene whose game is tablet"},
        "book": {"enum": ["sand_book", "weather_book", "road_book"]},
        "title": {"type": "string"},
        "tutorial": {"type": "boolean"},
        "want": {"type": "string"},
        "loophole_flag": {"type": "string", "description": "a bool in flags.json"},
        "also_sets": {"type": "array", "items": {"type": "string"}},
        "watcher": {"type": "string"},
        "watcher_rule": {"type": ["object", "null"], "required": ["text", "closes_way"], "properties": {
          "text": {"type": "string"}, "closes_way": {"type": "string"}}},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "object",
          "required": ["n", "text", "origin", "key_word", "meaning"],
          "properties": {
            "n": {"type": "integer", "minimum": 1},
            "text": {"type": "string"},
            "origin": {"enum": ["source", "added"]},
            "key_word": {"type": ["string", "null"]},
            "meaning": {"type": ["string", "null"]},
            "price": {"type": "boolean", "description": "a rule with 'or': a cost that may be paid, not a ban"}
          }}},
        "ways": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text"], "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "text": {"type": "string"}, "note": {"type": "string"}}}},
        "solution": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "why": {"type": "string"}
      }}}
  }
}
