{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "truth.json (Behind the Peephole)",
  "description": "The true answers: the six Statement grids (nights one to six), the night-seven Account, and the Mosaic's pins and true links. Evidence is a list of references: c.* (a clue card a beat writes), o.* (an office clue), slip.N (a slipped patience card), knock.nN (the knocks ledger entry for night N), row.nN.rXXX (a stamped Statement row).",
  "type": "object",
  "required": ["statements", "account", "mosaic"],
  "$defs": {
    "room": {"type": "string", "pattern": "^r40[1-6]$"},
    "ref": {"type": "string", "pattern": "^(c\\.n[1-7]\\.r40[1-6]\\.[a-z0-9_]+|o\\.n[1-7]\\.[a-z0-9_]+|slip\\.([1-9]|1[0-2])|knock\\.n[1-7]|row\\.n[1-6]\\.r40[1-6])$"},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 1},
    "option": {"type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}}},
    "options": {"type": "array", "items": {"$ref": "#/$defs/option"}, "minItems": 2}
  },
  "properties": {
    "statements": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object",
      "required": ["night", "scene", "rows", "categories", "truth"], "additionalProperties": false,
      "properties": {
        "night": {"type": "integer", "minimum": 1, "maximum": 6},
        "scene": {"type": "string"},
        "rows": {"type": "string", "description": "The label of the row axis (always the six rooms)."},
        "categories": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object",
          "required": ["id", "name", "options"],
          "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "options": {"$ref": "#/$defs/options"}}}},
        "truth": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object",
          "required": ["room", "answers", "evidence"], "additionalProperties": false,
          "properties": {
            "room": {"$ref": "#/$defs/room"},
            "answers": {"type": "object", "additionalProperties": {"type": "string"},
              "description": "One option id per category: the row's single true answer."},
            "evidence": {"type": "object", "additionalProperties": {"$ref": "#/$defs/refs"}}}}}}}},
    "account": {"type": "object", "required": ["scene", "second_look", "missions", "questions", "scapegoat"],
      "properties": {
        "scene": {"type": "string"},
        "second_look": {"const": false},
        "missions": {"type": "object", "required": ["options", "truth"],
          "properties": {
            "options": {"$ref": "#/$defs/options"},
            "truth": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object",
              "required": ["room", "answer", "evidence"], "additionalProperties": false,
              "properties": {"room": {"$ref": "#/$defs/room"}, "answer": {"type": "string"}, "evidence": {"$ref": "#/$defs/refs"}}}}}},
        "questions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object",
          "required": ["id", "question", "options", "answer", "evidence"], "additionalProperties": false,
          "properties": {
            "id": {"type": "string"}, "question": {"type": "string"},
            "options": {"$ref": "#/$defs/options"}, "answer": {"type": "string"},
            "evidence": {"$ref": "#/$defs/refs"}}}},
        "scapegoat": {"type": "object", "required": ["rule", "missions_in_order", "default", "flag"],
          "properties": {
            "rule": {"type": "string"},
            "missions_in_order": {"type": "array", "items": {"type": "string"}},
            "default": {"$ref": "#/$defs/room"},
            "flag": {"type": "string"}}}}},
    "mosaic": {"type": "object", "required": ["scenes", "lengths", "link_types", "pins", "links"],
      "properties": {
        "scenes": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Night number to Mosaic scene id."},
        "lengths": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}, "description": "Thread lengths per morning, by night."},
        "link_types": {"type": "array", "items": {"type": "object", "required": ["id", "name", "colour", "pattern"]}},
        "pins": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "name", "appears"],
          "properties": {
            "id": {"type": "string"},
            "kind": {"enum": ["guest", "place", "object", "person"]},
            "name": {"type": "string"},
            "appears": {"type": "object", "description": "When the pin is on the board: from a night, after a clue, card or flag, or when a link adds it."}}}},
        "links": {"type": "array", "items": {"type": "object",
          "required": ["id", "from", "to", "type", "earliest_night", "question", "effect", "evidence"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string"},
            "from": {"type": "string"},
            "to": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 2}],
              "description": "A pin id, or a list for a thread that fans to several pins (Wren to all six)."},
            "type": {"type": "string"},
            "earliest_night": {"type": "integer", "minimum": 2, "maximum": 6},
            "question": {"type": "string"},
            "effect": {"type": "object"},
            "evidence": {"$ref": "#/$defs/refs"},
            "true_when": {"type": "object", "description": "An extra condition for the link to be true."}}}}}}
  }
}
