{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beats.json (Behind the Peephole)",
  "description": "The per-night room scripts: returns, the 2:14 knock, every beat a lens or the gap can catch and the clue card it writes, the office clues, and the false signs an exposed guest stages. Times are hh:mm on the shift clock (23:00 to 05:00), as DESIGN.md writes them.",
  "type": "object",
  "required": ["rooms", "kinds", "regions", "shift", "bell_to_door_minutes", "window_minutes", "nights", "beats", "office_clues", "false_signs"],
  "$defs": {
    "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "room": {"type": "string", "pattern": "^r40[1-6]$"},
    "clue": {"type": "object", "required": ["id", "text"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "pattern": "^c[f]?\\.n[1-7]\\.r40[1-6](\\.[a-z0-9_]+)?$"}, "text": {"type": "string", "minLength": 1}}},
    "condition": {"type": "object", "description": "A condition in the endings.schema.json form, e.g. {\"is\": \"final_choice\", \"eq\": \"keep_logging\"}."}
  },
  "properties": {
    "rooms": {"type": "array", "items": {"$ref": "#/$defs/room"}, "minItems": 6, "maxItems": 6, "uniqueItems": true},
    "kinds": {"type": "array", "items": {"type": "string"}, "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "description": "The seven kinds of evidence (DESIGN.md section 3)."},
    "regions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true,
      "description": "Regions of a room plate; 'floor' is the gap strip only."},
    "shift": {"type": "object", "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}}},
    "bell_to_door_minutes": {"type": "integer", "minimum": 1},
    "window_minutes": {"type": "object", "required": ["min", "max"],
      "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}}},
    "nights": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object",
      "required": ["night", "chapter", "eye_scene", "race_scene", "knock", "returns"],
      "additionalProperties": false,
      "properties": {
        "night": {"type": "integer", "minimum": 1, "maximum": 7},
        "chapter": {"type": "string"},
        "eye_scene": {"type": "string"},
        "race_scene": {"type": "string"},
        "knock": {"type": "object", "required": ["room", "time"],
          "properties": {
            "room": {"type": "string", "pattern": "^(r40[1-6]|office)$"},
            "time": {"$ref": "#/$defs/time"},
            "time_if_seen_by_stranger": {"$ref": "#/$defs/time"}}},
        "returns": {"type": "array", "items": {"type": "object", "required": ["room"],
          "additionalProperties": false,
          "properties": {
            "room": {"$ref": "#/$defs/room"},
            "in": {"const": true, "description": "In the room all night; no bell."},
            "bell": {"$ref": "#/$defs/time"},
            "door": {"$ref": "#/$defs/time"},
            "requires": {"$ref": "#/$defs/condition"},
            "note": {"type": "string"}},
          "oneOf": [{"required": ["in"]}, {"required": ["bell", "door"]}]}}}}},
    "beats": {"type": "array", "items": {"type": "object",
      "required": ["id", "night", "room", "scene", "window", "kind", "region", "floor_visible", "clue"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^n[1-7]\\.r40[1-6]\\.[a-z0-9_]+$"},
        "night": {"type": "integer", "minimum": 1, "maximum": 7},
        "room": {"$ref": "#/$defs/room"},
        "scene": {"type": "string", "description": "A scene id from scenes.json (an eye-mode scene) where the beat can be caught."},
        "window": {"type": "object", "required": ["start", "end"], "additionalProperties": false,
          "properties": {"start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}}},
        "kind": {"type": "string"},
        "region": {"type": "string"},
        "floor_visible": {"type": "boolean", "description": "Can be caught from the gap (the light under the door)."},
        "threshold": {"const": true, "description": "Starts as the main door opens."},
        "ritual_broken": {"const": true},
        "requires": {"$ref": "#/$defs/condition"},
        "clue": {"$ref": "#/$defs/clue"}}}},
    "office_clues": {"type": "array", "items": {"type": "object",
      "required": ["id", "night", "source", "text"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^o\\.n[1-7]\\.[a-z0-9_]+$"},
        "night": {"type": "integer", "minimum": 1, "maximum": 7},
        "source": {"enum": ["office", "paper", "told", "strip", "found"]},
        "text": {"type": "string"},
        "requires_flag": {"type": "string", "description": "A bool flag from flags.json that must be true for the clue to be held."}}}},
    "false_signs": {"type": "object", "required": ["starts", "nights", "tell", "none", "substitutions"],
      "properties": {
        "starts": {"type": "string"},
        "nights": {"type": "array", "items": {"type": "integer"}},
        "tell": {"type": "string"},
        "none": {"type": "array", "items": {"type": "object", "required": ["night", "room", "reason"],
          "properties": {"night": {"type": "integer"}, "room": {"$ref": "#/$defs/room"}, "reason": {"type": "string"}}}},
        "substitutions": {"type": "array", "items": {"type": "object",
          "required": ["id", "night", "room", "replaces", "kind", "region", "floor_visible", "clue", "points_to"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^f\\.n[1-7]\\.r40[1-6]$"},
            "night": {"type": "integer", "minimum": 2, "maximum": 6},
            "room": {"$ref": "#/$defs/room"},
            "replaces": {"type": "string", "description": "The id of the true beat it replaces; it takes that beat's window."},
            "kind": {"type": "string"},
            "region": {"type": "string"},
            "floor_visible": {"type": "boolean"},
            "clue": {"$ref": "#/$defs/clue"},
            "points_to": {"type": "object", "required": ["category", "option"],
              "description": "The wrong answer the staged beat suggests, in that night's Statement.",
              "properties": {"category": {"type": "string"}, "option": {"type": "string"}}}}}}}}
  }
}
