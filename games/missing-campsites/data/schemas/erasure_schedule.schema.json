{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erasure_schedule.json",
  "description": "Missing Campsites: what erases at each erasure_step, and the trace each surface keeps (DESIGN.md section 12).",
  "type": "object",
  "required": ["flag", "postcard_lines", "steps", "traces", "show_seams"],
  "properties": {
    "source": {"type": "string"},
    "flag": {"type": "string", "description": "The counter that records the step."},
    "postcard_lines": {"type": "array", "items": {"type": "object",
      "required": ["id", "subject", "site", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "subject": {"type": "string"},
        "site": {"type": ["integer", "null"], "minimum": 1, "maximum": 24},
        "text": {"type": ["string", "null"], "description": "null where DESIGN.md has not written the line"}
      }}},
    "steps": {"type": "array", "items": {"type": "object",
      "required": ["step", "when", "scenes", "moment", "sites_lost", "things_lost", "legend_drops",
                   "map_stops_printing", "map_title_goes", "hud_post_counter", "photos", "photo_sites",
                   "postcard_lines_lost", "other_lines_lost", "log_and_objectives", "except_endings"],
      "properties": {
        "step": {"type": "integer", "minimum": 0},
        "when": {"type": "string"},
        "scenes": {"type": "array", "items": {"type": "string"}, "description": "Scenes in which (or at whose exit) the step advances"},
        "moment": {"type": "string"},
        "sites_lost": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 24}},
        "post_times_s": {"type": "array", "items": {"type": "object", "required": ["site", "seconds"],
          "properties": {"site": {"type": "integer"}, "seconds": {"type": "number", "minimum": 0}}}},
        "crosses": {"type": "boolean"},
        "things_lost": {"type": "array", "items": {"type": "object", "required": ["id", "name"],
          "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "unless_person_inside": {"type": "boolean"}}}},
        "legend_drops": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 24}},
        "map_stops_printing": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 24}},
        "map_title_goes": {"type": "boolean"},
        "hud_post_counter": {"type": ["object", "null"], "required": ["from", "to"],
          "properties": {"from": {"type": "integer"}, "to": {"type": "integer"}}},
        "photos": {"type": "string"},
        "photo_sites": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 24}},
        "postcard_lines_lost": {"type": "array", "items": {"type": "object", "required": ["line"],
          "properties": {"line": {"type": "string"}, "unless_anchor": {"type": "string"}}}},
        "postcard_lines_hold": {"type": "array", "items": {"type": "string"}},
        "other_lines_lost": {"type": "array", "items": {"type": "object", "required": ["id", "what", "site", "flag_if_copied"],
          "properties": {"id": {"type": "string"}, "what": {"type": "string"},
            "site": {"type": ["integer", "null"]}, "flag_if_copied": {"type": ["string", "null"]},
            "unless_anchor": {"type": "string"}}}},
        "log_and_objectives": {"type": "array", "items": {"type": "object", "required": ["surface", "what"],
          "properties": {"surface": {"enum": ["dialogue_log", "objectives"]}, "what": {"type": "string"}}}},
        "except_endings": {"type": "array", "items": {"type": "string"}, "description": "Ending ids on whose path this step does not happen"}
      }}},
    "traces": {"type": "array", "items": {"type": "object", "required": ["surface", "trace"],
      "properties": {"surface": {"type": "string"}, "trace": {"type": "string"}}}},
    "show_seams": {"type": "object", "required": ["setting", "default", "effect"],
      "properties": {"setting": {"type": "string"}, "default": {"type": "boolean"}, "effect": {"type": "string"}}}
  }
}
